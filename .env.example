# Rokid DocScan — environment configuration example.
# Copy to `.env` and adjust, or export these in your shell / container.
# EVERYTHING here is OPTIONAL: with none set, the server runs fully offline on
# the local placeholders (no credentials, no network).

# --- Storage ----------------------------------------------------------------
# Data root (SQLite DB + saved page images + listening recordings). Default: ./data
ROKID_DATA_DIR=data

# --- Provider routing (per port) --------------------------------------------
# Physical-device analysis/solving uses the configured server adapters. Local
# placeholders are for development only and are rejected by ROKID_REAL_MODE=1.
# Values: openai (GPT) | gemini | claude | local (development default).
ROKID_ANALYZER=local        # page summarization (finalize)
ROKID_SOLVER=local          # exam solving; a non-local value also makes
                            # finalize-reading solve ALL problems server-side
ROKID_EXPLAINER=local       # live document explanation
ROKID_EXTRACTOR=local       # formula/table/figure extraction
# ROKID_SOLVER=openai
# Two-tier fallback order for the solver (csv; "local" is auto-appended):
# ROKID_SOLVER_TIERS=openai,local

# --- Cloud model credentials + model ----------------------------------------
# Provide the key for whichever provider(s) you routed to above. Install only
# that provider's SDK: pip install openai | google-genai | anthropic
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=...            # (GEMINI_API_KEY is also accepted)
# ANTHROPIC_API_KEY=sk-ant-...
# Model id override — every provider has a working default
# (openai "gpt-4o" / gemini "gemini-2.5-flash" / anthropic "claude-opus-4-8"),
# so setting this is only needed to pick a different/newer model.
# ROKID_LLM_MODEL=gpt-4o
# ROKID_LLM_MAX_TOKENS=1024
# Optional custom Gemini endpoint. It is passed explicitly to google-genai.
# Local endpoints are rejected unless ROKID_ALLOW_LOCAL_LLM_ENDPOINT=1.
# GOOGLE_GEMINI_BASE_URL=https://example.invalid/v1
# Optional OpenAI-compatible endpoint (used for an on-phone llama-server or any
# other OpenAI-shaped server). Leave it UNSET to reach api.openai.com: a stale
# value here silently redirects ROKID_SOLVER=openai to a dead local port.
# OPENAI_BASE_URL=http://127.0.0.1:8080/v1
# Loopback/private endpoints are refused unless this is exactly "1", so a
# misconfigured host cannot quietly send exam pages somewhere unintended.
# ROKID_ALLOW_LOCAL_LLM_ENDPOINT=0

# --- ChatGPT web session solver (ROKID_SOLVER=chatgpt-web) -------------------
# Answers through the operator's own signed-in ChatGPT web session instead of a
# paid API key. Start the browser with --remote-debugging-port=9222 and sign in
# there first.
#
# WARNING: automating the ChatGPT web UI is against OpenAI's terms of use and
# can get the account restricted. This route is a deliberate operator choice.
#
# DevTools endpoint of that already-running browser.
# ROKID_CHATGPT_CDP=http://127.0.0.1:9222
# ROKID_CHATGPT_URL=https://chatgpt.com/
# How much of a session shares one chat:
#   question (default) — a fresh chat per question; no earlier answer leaks in.
#   subject            — one chat per 科目; a page is uploaded once per 大問
#                        instead of once per 小問.
# ROKID_CHATGPT_CHAT_SCOPE=question
# Send the captured pages as ONE PDF instead of individual images. The booklet
# path sets this implicitly; this variable is the manual override.
# ROKID_CHATGPT_BUNDLE_PDF=0
# Retries per question, and the backoff between them.
# ROKID_CHATGPT_ATTEMPTS=3
# ROKID_CHATGPT_RETRY_S=5
# Throttle brake: after this many consecutive generations slower than SLOW_S,
# the next send is refused instead of feeding a throttled account. 0 disables.
# ROKID_CHATGPT_SLOW_S=40
# ROKID_CHATGPT_SLOW_STREAK=2
# Waits (seconds): whole answer, file upload, composer becoming ready.
# ROKID_CHATGPT_TIMEOUT_S=180
# ROKID_CHATGPT_UPLOAD_S=20
# ROKID_CHATGPT_READY_S=30
# ROKID_CHATGPT_POLL_S=0.25
# ROKID_CHATGPT_STABLE_POLLS=4
# The page structure is OpenAI's, not ours. When they change the DOM, override
# the selector instead of editing code; the defaults are in
# app/solvers/chatgpt_web.py:
#   ROKID_CHATGPT_COMPOSER_SEL      ROKID_CHATGPT_ASSISTANT_SEL
#   ROKID_CHATGPT_NEW_CHAT_SEL      ROKID_CHATGPT_FILE_INPUT_SEL
#   ROKID_CHATGPT_FILE_UPLOAD_SEL   ROKID_CHATGPT_ATTACHMENT_SEL
#   ROKID_CHATGPT_STOP_SEL
# A throttled account is refused in the message BODY, not by an exception.
# These markers end a question immediately and are never retried (pipe-separated).
# ROKID_CHATGPT_RATE_LIMIT_MARKERS=使用制限|制限に達し|上限に達し|You've reached|usage limit|rate limit|too many requests

# --- Physical-device fail-closed mode ---------------------------------------
# Reject local, unknown, unready, and failed analyzer/solver fallbacks.
ROKID_REAL_MODE=0

# --- English-listening transcription ----------------------------------------
# Listening mode records the audio on the spot (/v1/exam-sessions/{id}/audio).
# Choose who transcribes it: openai | gemini | (unset = use the client-provided
# transcript as-is, fully offline). Anthropic has no ASR, so it is never used.
# ROKID_TRANSCRIBER=openai
# openai transcription model (default gpt-4o-transcribe). gemini reuses
# ROKID_LLM_MODEL (must be an audio-capable gemini model).
# ROKID_TRANSCRIBE_MODEL=gpt-4o-transcribe

# --- Exam-mode safety guardrail ---------------------------------------------
# Real-exam answering (mode=real) is locked off unless this is exactly "1".
ROKID_ALLOW_REAL_EXAM_SOLVE=0

# --- RAG retrieval ----------------------------------------------------------
# Enable dense-embedding retrieval (falls back to the lexical scorer until an
# analyzer supplies embeddings).
ROKID_ENABLE_EMBEDDING=0

# --- Diagnostic on-glasses KeyCode override ---------------------------------
# GET /v1/settings.input is diagnostic-only (operator_actions_enabled:false).
# The default KeyCodes are legacy/unverified. A measured map can be recorded
# here without enabling callbacks as product controls.
# Gestures: single_tap, double_tap, long_press, two_finger_tap,
# two_finger_swipe_left/right (problem/page nav), two_finger_swipe_up/down
# (teleprompter scroll), back.
# ROKID_KEYMAP={"single_tap": 23, "long_press": 170}

# --- Docker host exposure ---------------------------------------------------
# Compose publishes on loopback by default. For deliberate LAN access, change
# this to 0.0.0.0 and also set ROKID_API_KEY plus a TLS reverse proxy.
ROKID_BIND_HOST=127.0.0.1

# --- Optional server auth ---------------------------------------------------
# When set, all endpoints except discovery (/health, /v1/version, /v1/settings)
# require `Authorization: Bearer <this value>`. Unset = no auth (default).
# ROKID_API_KEY=change-me
